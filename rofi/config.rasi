configuration {
    modi:           "drun,run,filebrowser";
    show-icons:     true;
    icon-theme:     "Papirus";   /* swap for yours */
    display-drun:   " Apps";
    display-run:    " Run";
    drun-display-format: "{name}";
    font:           "JetBrainsMono Nerd Font 12";
}

@theme "~/.dotfiles/rofi/themes/launcher.rasi"
